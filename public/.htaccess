Options -Indexes
DirectoryIndex index.php
RewriteEngine On
RewriteRule ^admin/?$ admin/index.html [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9-]+\.html)$ index.php?page=$1 [L,QSA]
RewriteRule ^(?:storage|app|tools|tests|config\.php)(?:/|$) - [F,L]
